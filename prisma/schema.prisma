generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   // CENTRAL_MINISTRY, STATE_OFFICER, DISTRICT_COLLECTOR, REQUIRING_BODY, FIELD_OFFICER, LANDOWNER, ADMIN
  status       String   @default("ACTIVE") // ACTIVE, PENDING, DISABLED
  department   String?
  phone        String?
  jurisdiction String?
  linkedId     String?  // Links to Owner (OWN-xxxx), Project (PRJ-xxxx), District, or State
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String   @id // PRJ-001, etc.
  code             String   @unique // PRJ-001, etc.
  name             String
  nameHi           String?
  sector           String   // Highway, Rail, Canal/Irrigation, Industrial Corridor, Transmission Line
  state            String   @default("Madhya Pradesh")
  district         String
  tehsils          String
  status           String   // proposal, scrutiny, sia_appraisal, preliminary_notification, objections, final_declaration, award, compensation
  stage            String
  slaDeadline      DateTime
  isDelayed        Boolean  @default(false)
  delayRiskScore   Int      @default(10)
  delayReasons     String?  // JSON string array
  budgetCr         Float    @default(0)
  disbursedCr      Float    @default(0)
  targetAreaHa     Float    @default(0)
  acquiredAreaHa   Float    @default(0)
  totalParcels     Int      @default(0)
  affectedFamilies Int      @default(0)
  requiringBody    String   @default("National Highways Authority of India (NHAI)")
  startDate        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Village {
  id          String   @id // VLG-001, etc.
  name        String
  nameHi      String?
  tehsil      String
  district    String
  state       String   @default("Madhya Pradesh")
  lat         Float
  lng         Float
  parcelCount Int      @default(0)
}

model Owner {
  id                 String   @id // OWN-0001, etc.
  name               String
  nameHi             String?
  gender             String?
  maskedPhone        String
  maskedAadhaar      String?
  address            String?
  villageId          String?
  bankAccountMasked  String?
  ifsc               String?
  isVulnerable       Boolean  @default(false)
  vulnerabilityType  String?  // SC, ST, WOMEN_HEADED, MARGINAL_FARMER
  familyMembers      Int      @default(4)
  rrPackageAssigned  Boolean  @default(false)
  rrEntitlementsJson String?
  createdAt          DateTime @default(now())
}

model Parcel {
  id                    String   @id // PCL-0001, etc.
  ulpin                 String   @unique
  surveyNo              String
  subDivision           String?
  villageId             String
  villageName           String
  district              String
  tehsil                String
  areaHa                Float
  landUse               String   // Agricultural, Residential, Barren, Mixed Use
  status                String   // proposed, notified, objections, awarded, compensation_paid, possessed, disputed_litigation
  geometry              String   // GeoJSON polygon coordinates string
  centerLat             Float
  centerLng             Float
  ownerId               String?
  ownerName             String?
  projectId             String?
  projectName           String?
  marketValuePerHa      Float    @default(3500000)
  calculatedCompensation Float   @default(0)
  paidCompensation      Float    @default(0)
  isLitigation          Boolean  @default(false)
  litigationCaseNumber  String?
  litigationCaseType    String?
  litigationCourt       String?
  litigationStatus      String?
  isEcoSensitive        Boolean  @default(false)
  isMultiProjectOverlap Boolean  @default(false)
  overlappingProjectId  String?
  overlapNote           String?
  overlappingProjects   String?
  createdAt             DateTime @default(now())
}

model LitigationCase {
  id          String   @id // Case number or CUID
  caseNumber  String   @unique
  parcelId    String
  caseType    String
  court       String
  filedDate   DateTime?
  status      String   // stayed, hearing_scheduled, pending
  createdAt   DateTime @default(now())
}

model ParcelProjectOverlap {
  id                   String @id // OVL-001, etc.
  parcelId             String
  primaryProjectId     String
  overlappingProjectId String
  note                 String?
}

model ProjectStageHistory {
  id        String    @id // STG-001, etc.
  projectId String
  stage     String
  startDate DateTime
  endDate   DateTime?
  status    String    // completed, in_progress
  slaDays   Int       @default(30)
}

model CandidateAlignment {
  id                     String   @id // ALN-1, etc.
  alignmentId            String   @unique
  projectId              String
  name                   String
  description            String?
  label                  String?
  bufferWidthMeters      Float    @default(100)
  lineGeometry           String   // GeoJSON LineString
  affectedParcelsCount   Int      @default(0)
  affectedAreaHa         Float    @default(0)
  estimatedCostCr        Float    @default(0)
  displacedFamiliesCount Int      @default(0)
  forestWaterOverlapHa   Float    @default(0)
  isRecommended          Boolean  @default(false)
  recommendationScore    Float    @default(80)
  recommendationReasons  String   @default("")
}

model RrFamily {
  id                      String   @id // RRF-0001, etc.
  familyId                String   @unique
  parcelId                String
  ownerId                 String
  projectId               String
  membersCount            Int      @default(4)
  vulnerableScSt          Boolean  @default(false)
  vulnerableWomenHeaded   Boolean  @default(false)
  entitlementHouse        Boolean  @default(false)
  entitlementEmployment   Boolean  @default(false)
  subsistenceAllowanceInr Int      @default(0)
  rrStatus                String   @default("pending") // pending, in_progress, completed
  geotaggedEvidence       String?  // JSON string storing geotagged inspection evidence
  createdAt               DateTime @default(now())
}

model Grievance {
  id               String    @id // GRV-001 or cuid
  trackingNo       String    @unique
  parcelId         String?
  parcelUlpin      String?
  surveyNo         String?
  ownerId          String?
  projectId        String?
  applicantName    String
  applicantPhone   String
  category         String    // Compensation amount dispute, Boundary/survey discrepancy, etc.
  description      String
  status           String    @default("open") // open, under_review, resolved
  hearingDate      DateTime?
  resolutionNotes  String?
  filedAt          DateTime  @default(now())
  resolvedAt       DateTime?
}

model Document {
  id             String   @id // DOC-0001, etc.
  documentId     String   @unique
  parcelId       String?
  projectId      String?
  docType        String   // Possession_Certificate, Objection_Reply, etc.
  filename       String
  version        Int      @default(1)
  sha256Hash     String
  uploadedByRole String
  uploadedDate   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actorEmail  String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  details     String
  ipAddress   String?
  prevHash    String   @default("")
  hash        String   @default("")
}

model AppNotification {
  id             String   @id @default(cuid())
  recipientEmail String
  recipientRole  String?
  title          String
  titleHi        String?
  message        String
  messageHi      String?
  type           String   @default("GENERAL") // SLA_WARNING, STAGE_CHANGE, GRIEVANCE, PAYMENT, GENERAL
  isRead         Boolean  @default(false)
  channel        String   @default("IN_APP")
  createdAt      DateTime @default(now())
}

model SystemConfig {
  id                      String   @id @default("default")
  simulatedDateOffsetDays Int      @default(0)
  slaProposalScrutinyDays Int      @default(15)
  slaSiaAppraisalDays     Int      @default(60)
  slaObjectionHearingDays Int      @default(60)
  slaAwardEnquiryDays     Int      @default(90)
  solatiumPercentage      Float    @default(100.0)
  ruralMultiplier         Float    @default(1.5)
  additionalInterestRate  Float    @default(12.0)
  updatedAt               DateTime @updatedAt
}
