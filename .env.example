# Database Configuration (SQLite local or PostgreSQL Neon/Supabase/Docker)
# For local SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/lams_db?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Notification Gateways (Default is MOCK)
SMS_GATEWAY_PROVIDER="MOCK"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# RESEND_API_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
